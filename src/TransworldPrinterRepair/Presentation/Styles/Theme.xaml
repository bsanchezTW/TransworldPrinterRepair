<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework">

    <controls:BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- ================= Paleta ================= -->

    <Color x:Key="BackgroundColor">#F4F6F9</Color>
    <Color x:Key="AccentColor">#2563EB</Color>
    <Color x:Key="ShadowColor">#0F172A</Color>

    <SolidColorBrush x:Key="BackgroundBrush"    Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush"       Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceHoverBrush"  Color="#F7FAFF" />
    <SolidColorBrush x:Key="BorderBrush"        Color="#E2E6ED" />
    <SolidColorBrush x:Key="BorderStrongBrush"  Color="#C9D2E0" />

    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#14181F" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#667085" />
    <SolidColorBrush x:Key="TextMutedBrush"     Color="#98A2B3" />

    <SolidColorBrush x:Key="AccentBrush"        Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush"   Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1E40AF" />
    <SolidColorBrush x:Key="AccentSoftBrush"    Color="#EEF4FF" />

    <SolidColorBrush x:Key="SuccessBrush"       Color="#16A34A" />
    <SolidColorBrush x:Key="SuccessSoftBrush"   Color="#ECFDF3" />
    <SolidColorBrush x:Key="DangerBrush"        Color="#D92D20" />
    <SolidColorBrush x:Key="DangerSoftBrush"    Color="#FEF3F2" />
    <SolidColorBrush x:Key="WarningBrush"       Color="#B54708" />

    <!-- ================= Tipografia =================
         Segoe UI Variable existe en Windows 11; en Windows 10 cae a Segoe UI. -->

    <FontFamily x:Key="UiFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="UiFontText">Segoe UI Variable Text, Segoe UI</FontFamily>

    <sys:Double x:Key="RadiusLarge">16</sys:Double>
    <CornerRadius x:Key="CardRadius">14</CornerRadius>
    <CornerRadius x:Key="ButtonRadius">10</CornerRadius>

    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SubtitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontText}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontText}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="LabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontText}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="ValueText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <!-- ================= Efectos ================= -->

    <DropShadowEffect x:Key="CardShadow"
                      Color="{StaticResource ShadowColor}"
                      BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.07" />

    <DropShadowEffect x:Key="CardShadowHover"
                      Color="{StaticResource ShadowColor}"
                      BlurRadius="26" ShadowDepth="5" Direction="270" Opacity="0.13" />

</ResourceDictionary>

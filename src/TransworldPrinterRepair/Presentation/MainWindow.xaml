<Window x:Class="Transworld.PrinterRepair.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reparación de Impresora Transworld"
        Icon="/Resources/logo.png"
        Height="660" Width="920"
        MinHeight="660" MinWidth="920"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource UiFontText}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabecera discreta: identifica la herramienta sin robar protagonismo. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="40,26,40,0">
            <Image Source="/Resources/logo.png" Width="30" Height="30"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="Transworld" Margin="10,0,0,0" VerticalAlignment="Center"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Soporte de impresión" Margin="10,0,0,0" VerticalAlignment="Center"
                       FontSize="13" Foreground="{StaticResource TextMutedBrush}" />
        </StackPanel>

        <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
    </Grid>
</Window>

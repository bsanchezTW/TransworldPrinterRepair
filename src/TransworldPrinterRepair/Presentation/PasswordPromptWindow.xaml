<Window x:Class="Transworld.PrinterRepair.Presentation.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acceso administrativo"
        Height="290" Width="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource UiFontText}"
        UseLayoutRounding="True">

    <Grid Margin="30,26,30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Configuración administrativa"
                   FontFamily="{StaticResource UiFont}" FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}" />

        <TextBlock Grid.Row="1" Margin="0,8,0,0" FontSize="13" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Text="Introduce la contraseña de administrador para continuar." />

        <PasswordBox x:Name="Password" Grid.Row="2" Margin="0,20,0,0"
                     Height="40" FontSize="15" Padding="12,0"
                     VerticalContentAlignment="Center"
                     BorderBrush="{StaticResource BorderStrongBrush}"
                     Background="{StaticResource SurfaceBrush}"
                     KeyDown="OnPasswordKeyDown" />

        <TextBlock x:Name="ErrorText" Grid.Row="3" Margin="0,10,0,0"
                   FontSize="12" TextWrapping="Wrap"
                   Foreground="{StaticResource DangerBrush}"
                   Visibility="Collapsed" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Bottom">
            <Button Content="Cancelar" Click="OnCancel" IsCancel="True"
                    Style="{StaticResource SecondaryButton}" Height="40" Padding="22,0"
                    Margin="0,0,10,0" />
            <Button Content="Entrar" Click="OnAccept" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" Height="40" Padding="26,0" />
        </StackPanel>
    </Grid>
</Window>

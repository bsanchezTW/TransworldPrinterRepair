<UserControl x:Class="Transworld.PrinterRepair.Presentation.Views.RepairResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Style="{StaticResource PageRoot}" Margin="40,28,40,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Center" MaxWidth="600"
                    HorizontalAlignment="Left">

            <!-- Icono de exito -->
            <Border x:Name="SuccessBadge" Width="64" Height="64" CornerRadius="32"
                    Background="{StaticResource SuccessSoftBrush}" HorizontalAlignment="Left"
                    Visibility="{Binding Success, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="✓" FontSize="30" FontWeight="Bold"
                           Foreground="{StaticResource SuccessBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- Icono de fallo -->
            <Border Width="64" Height="64" CornerRadius="32"
                    Background="{StaticResource DangerSoftBrush}" HorizontalAlignment="Left"
                    Visibility="{Binding Failed, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="!" FontSize="30" FontWeight="Bold"
                           Foreground="{StaticResource DangerBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <TextBlock Text="{Binding Title}" Style="{StaticResource TitleText}" Margin="0,22,0,0" />

            <TextBlock Text="{Binding PrinterName}" Margin="0,14,0,0"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource AccentBrush}"
                       Visibility="{Binding Success, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="{Binding Message}" Style="{StaticResource SubtitleText}" Margin="0,12,0,0" />

            <TextBlock Text="{Binding TestPageStatus}" Margin="0,16,0,0" FontSize="13"
                       Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />

            <Button Content="Ver detalles técnicos" Command="{Binding OpenLogsCommand}"
                    Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                    Margin="-6,14,0,0"
                    Visibility="{Binding Failed, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- Acciones de exito -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Visibility="{Binding Success, Converter={StaticResource BoolToVisibility}}">
            <Button Content="Imprimir página de prueba" Command="{Binding PrintTestPageCommand}"
                    Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" />
            <Button Content="Finalizar" Command="{Binding FinishCommand}"
                    Style="{StaticResource PrimaryButton}" IsDefault="True" />
        </StackPanel>

        <!-- Acciones de fallo -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Visibility="{Binding Failed, Converter={StaticResource BoolToVisibility}}">
            <Button Content="Volver al inicio" Command="{Binding BackCommand}"
                    Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" />
            <Button Content="Reintentar" Command="{Binding RetryCommand}"
                    Style="{StaticResource PrimaryButton}" IsDefault="True" />
        </StackPanel>
    </Grid>
</UserControl>

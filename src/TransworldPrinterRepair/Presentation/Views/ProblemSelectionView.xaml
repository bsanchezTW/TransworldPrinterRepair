<UserControl x:Class="Transworld.PrinterRepair.Presentation.Views.ProblemSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Style="{StaticResource PageRoot}" Margin="40,28,40,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" Style="{StaticResource TitleText}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SubtitleText}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,30,0,0" VerticalAlignment="Top">
            <Button Command="{Binding ContinueCommand}"
                    Style="{StaticResource CardButton}"
                    AutomationProperties.Name="{Binding ProblemTitle}"
                    Height="94" MaxWidth="560" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <Border Width="46" Height="46" CornerRadius="12"
                            Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                        <TextBlock Text="🖨" FontSize="22" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProblemTitle}" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding ProblemDescription}" FontSize="13"
                                   FontWeight="Normal" Margin="0,4,0,0" MaxWidth="400"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Button>
        </StackPanel>

        <Button Grid.Row="2" Content="← Volver" Command="{Binding BackCommand}"
                Style="{StaticResource LinkButton}" HorizontalAlignment="Left" />
    </Grid>
</UserControl>
